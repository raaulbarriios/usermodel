{
	"info": {
		"_postman_id": "b3e91a62-4217-4e76-8fa8-69e1b2f4f210",
		"name": "UserModel API - Laravel (Tokens)",
		"description": "Colección con las 4 llamadas requeridas para la API de User y Token en Laravel",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. GET - Obtener los 10 primeros usuarios",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/get",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"get"
					]
				},
				"description": "Obtiene la lista de los 10 primeros usuarios registrados."
			},
			"response": []
		},
		{
			"name": "2. CREATE - Crear un nuevo usuario",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Carlos Rodríguez\",\n  \"username\": \"carlosr\",\n  \"email\": \"carlos@example.com\",\n  \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/create",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"create"
					]
				},
				"description": "Crea un usuario hasheando la contraseña antes de guardarla en la base de datos."
			},
			"response": []
		},
		{
			"name": "3. LOGIN - Iniciar sesión (Genera token)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var response = pm.response.json();",
							"if (response.success && response.data) {",
							"    pm.collectionVariables.set(\"token\", response.data);",
							"    console.log(\"Token guardado automáticamente:\", response.data);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"carlos@example.com\",\n  \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"login"
					]
				},
				"description": "Inicia sesión verificando credenciales, borra tokens previos y devuelve un nuevo token de sesión que se guarda automáticamente en la variable {{token}}."
			},
			"response": []
		},
		{
			"name": "4. UPDATE NAME - Actualizar nombre con token",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"token\": \"{{token}}\",\n  \"name\": \"Carlos Rodríguez Actualizado\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/update_name",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"update_name"
					]
				},
				"description": "Actualiza el campo name pasándole el token de sesión y el nuevo nombre."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://usermodel.test",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	]
}
